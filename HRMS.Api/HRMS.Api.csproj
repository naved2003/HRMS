<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- HRMS.Api is an Sdk.Web project, so it implicitly references the
         Microsoft.AspNetCore.App shared framework (which contains Identity EF Core).
         No need for an explicit Identity EF Core NuGet package here. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!--
      Swashbuckle.AspNetCore 7.0.0 dropped the Microsoft.OpenApi.Models namespace,
      which the SwaggerDoc(... new OpenApiInfo {...}) call in Program.cs depends on.
      Downgraded to 6.9.0 (latest stable 6.x) which still references
      Microsoft.OpenApi 1.x and exposes Microsoft.OpenApi.Models.OpenApiInfo.
    -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HRMS.Core\HRMS.Core.csproj" />
    <ProjectReference Include="..\HRMS.Infrastructure\HRMS.Infrastructure.csproj" />
    <ProjectReference Include="..\HRMS.Services\HRMS.Services.csproj" />
  </ItemGroup>

</Project>
