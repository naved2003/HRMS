<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Reference the ASP.NET Core shared framework directly. FrameworkReference does
      NOT propagate transitively through ProjectReference (unlike PackageReference),
      so each project that consumes ASP.NET Core types must add it explicitly.
      Services needs Microsoft.AspNetCore.Identity for SignInManager<ApplicationUser>
      and UserManager<ApplicationUser>, plus Microsoft.AspNetCore.Http for
      IHttpContextAccessor.
      Note: Microsoft.Extensions.DependencyInjection.Abstractions and
      Microsoft.Extensions.Logging.Abstractions are NOT listed as PackageReferences
      because they are already part of the Microsoft.AspNetCore.App shared framework.
      Listing them explicitly triggers NU1510 warning which fails PMC migrations
      when ErrorActionPreference=Stop.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />

    <!--
      AutoMapper 12.0.1 is the last version compatible with
      AutoMapper.Extensions.Microsoft.DependencyInjection 12.0.0.
      AutoMapper 13+ removed the MapperConfiguration(MapperConfigurationExpression)
      constructor that the DI extension package calls, causing
      MissingMethodException at runtime.
    -->
    <PackageReference Include="AutoMapper" Version="12.0.1" />
    <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" Version="12.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HRMS.Core\HRMS.Core.csproj" />
    <ProjectReference Include="..\HRMS.Infrastructure\HRMS.Infrastructure.csproj" />
  </ItemGroup>

</Project>
